---
import { Picture } from 'astro:assets';
import GearPicker from './GearPicker.astro';
import { photo } from '../data/photos';
import { EXPERIENCES } from '../data/experiences';
import { GEAR } from '../data/gear';
import { getDict } from '../i18n';
import { SITE, LANGS, LANG_NAMES, type Lang } from '../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const b = t.booking;

/** Données utiles au script (prix, libellés) — sérialisées une fois dans la page. */
const runtime = {
  lang,
  whatsapp: SITE.whatsapp,
  prices: Object.fromEntries(EXPERIENCES.map((e) => [e.id, e.price])),
  gearPrices: Object.fromEntries(GEAR.map((g) => [g.id, g.price])),
  gearNames: t.gear.items,
  mad: t.units.mad,
  t: {
    hello: b.hello, estimate: b.estimate, gearPerDay: b.gearPerDay, opening: b.opening, fallback: b.fallback,
    experience: b.experience, option: b.option, date: b.date, people: b.people, city: b.city,
    guideLang: b.guideLang, gear: b.gear, name: b.name, phone: b.phone, send: b.send, modalNone: b.modalNone,
  },
};
const guideLangs: Record<Lang, string> = { fr: 'Français', en: 'English', ar: 'الدارجة' };
---
<section class="section booking theme-light" id="book" aria-labelledby="book-title">
  <div class="wrap booking__grid">
    <div class="booking__intro">
      <p class="eyebrow" data-reveal>{b.eyebrow}</p>
      <h2 class="h2" id="book-title" data-reveal>{b.title}</h2>
      <p class="lead muted" data-reveal>{b.lead}</p>
      <div class="booking__cities" data-reveal>
        <span>{b.departuresLabel}</span>
        <strong>{t.cities.casablanca}</strong>
        <strong>{t.cities.rabat}</strong>
      </div>
    </div>

    <form class="form" id="booking-form" novalidate data-booking>
      <div class="form__row">
        <div class="field">
          <label for="f-name">{b.name}</label>
          <input id="f-name" name="name" autocomplete="name" required aria-describedby="f-name-err" />
          <p class="field__err" id="f-name-err" hidden>{b.required}</p>
        </div>
        <div class="field">
          <label for="f-phone">{b.phone}</label>
          <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required aria-describedby="f-phone-err" />
          <p class="field__err" id="f-phone-err" hidden>{b.required}</p>
        </div>
      </div>

      <div class="field">
        <label for="f-xp">{b.experience}</label>
        <select id="f-xp" name="experience" required aria-describedby="f-xp-err">
          <option value="">{b.pick}</option>
          {EXPERIENCES.map((e) => <option value={e.id}>{t.experiences.items[e.id].name}</option>)}
        </select>
        <p class="field__err" id="f-xp-err" hidden>{b.required}</p>
      </div>

      <fieldset class="field field--options" data-options hidden>
        <legend>{b.option}</legend>
        <div class="seg">
          <label><input type="radio" name="option" value={b.optionAscent} checked /><span>{b.optionAscent}</span></label>
          <label><input type="radio" name="option" value={b.optionGorges} /><span>{b.optionGorges}</span></label>
        </div>
      </fieldset>

      <div class="form__row">
        <div class="field">
          <label for="f-date">{b.date}</label>
          <input id="f-date" name="date" type="date" data-min-today />
        </div>
        <div class="field">
          <label for="f-people">{b.people}</label>
          <input id="f-people" name="people" type="number" min="1" max="30" value="2" inputmode="numeric" />
        </div>
      </div>

      <div class="form__row">
        <div class="field">
          <label for="f-city">{b.city}</label>
          <select id="f-city" name="city">
            <option value={t.cities.casablanca}>{t.cities.casablanca}</option>
            <option value={t.cities.rabat}>{t.cities.rabat}</option>
          </select>
        </div>
        <div class="field">
          <label for="f-glang">{b.guideLang}</label>
          <select id="f-glang" name="guideLang">
            {LANGS.map((l) => <option value={guideLangs[l]} selected={l === lang} lang={l}>{guideLangs[l]}</option>)}
          </select>
        </div>
      </div>

      <details class="field gear-pick" data-gear-pick>
        <summary class="gear-pick__sum">
          <span class="gear-pick__txt">
            <span class="gear-pick__label">{b.gear}</span>
            <span class="gear-pick__note">{t.gear.title} {t.gear.lead}</span>
          </span>
          <span class="gear-pick__count num" data-gear-count hidden></span>
          <span class="qa__icon" aria-hidden="true"></span>
        </summary>
        <div class="gear-pick__body">
          <GearPicker lang={lang} />
        </div>
      </details>

      <div class="field">
        <label for="f-msg">{b.message}</label>
        <textarea id="f-msg" name="message" rows="3"></textarea>
      </div>

      <div class="form__foot">
        <p class="estimate" aria-live="polite" data-estimate></p>
        <button class="btn btn--wa" type="submit">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="wa-icon"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
          {b.send}
        </button>
        <p class="form__status" role="status" data-status></p>
      </div>
    </form>
  </div>

  <dialog class="gear-modal" data-gear-modal aria-labelledby="gm-title" aria-describedby="gm-lead">
    <div class="gear-modal__in">
      <button type="button" class="gear-modal__x" data-modal-close aria-label={b.modalClose}>
        <span aria-hidden="true">×</span>
      </button>
      <figure class="gear-modal__ph">
        <Picture src={photo('gear-hammock-tent')} alt="" widths={[480, 800]} sizes="(min-width: 600px) 560px, 92vw"
          formats={['avif', 'webp']} quality={66} loading="lazy" />
      </figure>
      <div class="gear-modal__body">
        <p class="eyebrow">{t.gear.eyebrow}</p>
        <h2 class="h3" id="gm-title">{b.modalTitle}</h2>
        <p class="muted" id="gm-lead">{b.modalLead}</p>
        <GearPicker lang={lang} mirror />
        <p class="estimate" aria-live="polite" data-modal-estimate></p>
        <div class="gear-modal__actions">
          <button type="button" class="btn btn--wa btn--block" data-modal-send>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="wa-icon"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            <span data-modal-send-label>{b.modalNone}</span>
          </button>
          <button type="button" class="gear-modal__back" data-modal-close>{b.modalBack}</button>
        </div>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="booking-data" set:html={JSON.stringify(runtime)} />
</section>

<script>
  import { initBooking } from '../scripts/booking';
  initBooking();
</script>
