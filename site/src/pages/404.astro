---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { LANGS } from '../config/site';
import { getDict, localeUrl } from '../i18n';
---
<Base lang="fr" noindex>
  <main id="main" class="notfound">
    <Logo width={240} />
    {LANGS.map((l) => {
      const t = getDict(l);
      return (
        <section lang={l} dir={l === 'ar' ? 'rtl' : 'ltr'}>
          <h1 class="h3">{t.notFound.title}</h1>
          <p class="muted">{t.notFound.text} <a href={localeUrl(l)}>{t.notFound.back}</a></p>
        </section>
      );
    })}
  </main>
</Base>
